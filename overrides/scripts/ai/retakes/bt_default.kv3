<!-- kv3 encoding:text:version{e21c7f3c-8a33-41c5-9977-a76d3a32aa0d} format:generic:version{7412167c-06e9-4698-aff2-e63eb59037e7} -->
// Retakes bots. CTs defuse and push the site, Ts hide around the bomb.
{
	config = "scripts/ai/retakes/bt_config.kv3"
	root =
	{
		type = "decorator_bot_service"
		memory_to_expire =
		[
			{
				key = "ShortTermAttackMemory"
				time = 0.7
				distance = 50
			},
			{
				key = "LongTermMemory"
				time = 60
				distance = 3000
			},
			{
				key = "ShortTermInvestigateMemory"
				time = 6
				distance = 500
			}
		]
		child =
		{
			type = "parallel"
			children =
			[
				{
					type = "decorator_repeat"
					child =
					{
						type = "parallel"
						children =
						[
							// memorize enemies through vision
							{
								type = "subtree"
								file = "scripts/ai/modules/bt_memorize_enemies_vision.kv3"
								name = "MemorizeEnemiesVision"
							},
							// memorize noises happening right now
							{
								type = "subtree"
								file = "scripts/ai/modules/bt_memorize_noises.kv3"
								name = "MemorizeNoises"
							},
							// record the nearest memorized event to investigate
							{
								type = "subtree"
								file = "scripts/ai/modules/bt_memorize_nearest_investigation.kv3"
								name = "MemorizeNearestInvestigation"
							}
						]
					}
				},
				{
					type = "decorator_repeat"
					child =
					{
						type = "selector"
						children =
						[
							// face the damage source if we're taking damage
							{
								type = "decorator_sensor"
								entity_type_filter = "DAMAGE"
								output = "Damage"
								priority = 0
								child =
								{
									type = "condition_is_empty"
									input = "Damage"
									negated = 1
									child =
									{
										type = "action_aim"
										input = "Damage"
										acquire_only = 1
									}
								}
							},
							// Else: attack if we see an enemy
							{
								type = "subtree"
								file = "scripts/ai/modules/bt_attack.kv3"
								name = "Attack"
							},
							// Else: one CT goes for the defuse
							{
								type = "condition_is_equal"
								source = "TeamName"
								destination = "'CT'"
								child =
								{
									type = "subtree"
									file = "scripts/ai/retakes/modules/bt_defuse_planted_bomb.kv3"
									name = "DefusePlantedBomb"
								}
							},
                            // Else: Ts leave cover and defend the bomb while it is being defused
                            {
                            	type = "condition_is_equal"
                                source = "TeamName"
                                destination = "'T'"
                                child =
                                {
                                    type = "condition_is_empty"
                                    global = 1
                                    negated = 1
                                    input = "DefuseInProgress"
                                    child =
                                    {
                                        type = "subtree"
                                        file = "scripts/ai/retakes/modules/bt_defend_bomb_during_defuse.kv3"
                                        name = "DefendBombDuringDefuse"
                                    }
                                }
                            },
							// Else: Ts take cover around the bomb
							{
								type = "condition_is_equal"
								source = "TeamName"
								destination = "'T'"
								child =
								{
									type = "condition_is_empty"
									global = 1
									input = "DefuseInProgress"
									child =
									{
										type = "subtree"
										file = "scripts/ai/retakes/modules/bt_hide_near_planted_bomb.kv3"
										name = "HideNearPlantedBomb"
									}
								}
							},
							// Else: CTs push onto the site
							{
								type = "condition_is_equal"
								source = "TeamName"
								destination = "'CT'"
								child =
								{
									type = "subtree"
									file = "scripts/ai/retakes/modules/bt_hold_near_planted_bomb.kv3"
									name = "HoldNearPlantedBomb"
								}
							},
							// Else: investigate the closest memorized event
							{
								type = "subtree"
								file = "scripts/ai/modules/bt_investigate_closest_memorized_event.kv3"
								name = "InvestigateClosestMemorizedEvent"
							},
							// Else: hunt. Only reached with no bomb, like warmup.
							{
								type = "sequencer"
								children =
								[
									{
										type = "decorator_random_approach_point"
										output = "TargetHuntArea"
									},
									{
										type = "action_move_to"
										destination = "TargetHuntArea"
										movement_type = "BT_ACTION_MOVETO_RUN"
										route_type = "BT_ACTION_MOVETO_FASTEST_ROUTE"
									}
								]
							}
						]
					}
				}
			]
		}
	}
}
