{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Arena",
  "version": "1.4.2-preview.2+6",
  "identifier": "com.localarena.panel",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Local Arena",
        "width": 1300,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
